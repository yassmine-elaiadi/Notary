# Copy this file to .env and fill in your values. Never commit .env.

# Which model writes the answers: "groq" (free API), "mistral" (paid API) or "ollama" (local, offline)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only used when LLM_PROVIDER=mistral (https://console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Only used when LLM_PROVIDER=ollama
# OLLAMA_MODEL=phi3
